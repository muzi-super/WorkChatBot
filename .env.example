# 企微机器人ID
WE_COM_BOT_ID=""
# 企微机器人密钥
WE_COM_BOT_SECRET=""
# Ollama地址
OLLAMA_URL=""
# Ollama超时时间
OLLAMA_TIMEOUT="10m"
# 保持 alive 时间
KEEP_ALIVE="60m"
# 文本模型名称
TEXT_MODEL_NAME="qwen3:14b"
# 图像模型名称
IMAGE_MODEL_NAME="qwen2.5vl:7b"
# 是否思考
THINK=true
# 模型选项
MODEL_OPTIONS={"temperature":0.7,"num_ctx":8192}
# 格式选项
# FORMATS={"type":"text"}
# 模型系统内容
MODEL_SYSTEM_CONTENT="你是影刀智能助手, 请回答用户询问的问题并提供详细答案, 请保持简洁明了避免冗长。"
# 工作协程数量
WORKER_COUNT=4
# 聊天任务数量
CHAT_JOB_COUNT=10
# ===== 日志配置 =====
# 日志级别: DEBUG / INFO / WARN / ERROR
LOG_LEVEL=DEBUG
# 日志文件路径（相对路径，留空则只输出到控制台）
LOG_FILE=logs/app.log
# 日志格式: text / json
LOG_FORMAT=text
# 日志轮转: daily=每天新建并归档旧文件, none=不轮转
LOG_ROTATE=daily
